option('build_tests', type: 'boolean', value: true)
option('build_benchmarks', type: 'boolean', value: true)
option('cpu_arch',
  type: 'combo',
  choices: ['auto', 'native', 'znver5', 'znver4', 'znver3', 'generic'],
  value: 'auto',
  description: 'Target x86 microarchitecture. "auto" = portable generic AVX2 (safe for dev boxes/CI); "native" = host CPU; "znverN" = AMD Zen (adds -mprefer-vector-width=512 for AVX-512 Zen4/5). Non-auto targets emit ISA the build host may not run.'
)
option('blas_backend',
  type: 'combo',
  choices: ['auto', 'openblas', 'mkl', 'Accelerate', 'aocl', 'generic'],
  value: 'auto',
  description: 'BLAS implementation to use'
)

option('mkl_root',
  type: 'string',
  value: '',
  description: 'Path to Intel MKL root directory (overrides MKLROOT env var)'
)

option('aocl_root',
type: 'string',
value: '',
description: 'Path to AMD AOCL root directory'
)

option('hdf5_root', type: 'string', value: '', description: 'Path to custom HDF5 installation (prefix directory)')
option('mpi_root', type: 'string', value: '', description: 'Path to custom MPI installation (prefix directory)')

  

